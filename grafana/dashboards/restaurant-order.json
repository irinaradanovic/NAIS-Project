                      "kind": "DataQuery",
                      "spec": {
                        "cypherQuery": "MATCH (m:Menu)-[:HAS_CATEGORY]->(c:Category)-[:INCLUDES_ITEM]->(i:MenuItem)\r\nWHERE m.deactivationDate IS NULL\r\n  AND i.timeMin IS NOT NULL\r\n  AND i.timeMax IS NOT NULL\r\nWITH \r\n    c.name AS category,\r\n    round(avg(i.timeMin), 1) AS avgMinTime,\r\n    round(avg(i.timeMax), 1) AS avgMaxTime,\r\n    min(i.timeMin) AS fastestItem,\r\n    max(i.timeMax) AS slowestItem\r\nRETURN category, avgMinTime, avgMaxTime, fastestItem, slowestItem\r\nORDER BY avgMaxTime DESC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
